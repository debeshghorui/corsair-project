# Copy this file to .env and fill in the blanks. Never commit .env.
#   cp .env.example .env

# --- Database (Neon Postgres; pgvector must be available) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Corsair ---
# Key-encryption key. Encrypts shared Google credentials at rest.
# Generate one with: openssl rand -base64 32
CORSAIR_KEK=""

# Optional. Encrypts each user's OpenAI key (AES-256-GCM).
# If unset, CORSAIR_KEK is used.
# SECRETS_ENC_KEY=""

# --- Clerk (https://dashboard.clerk.com → API keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_"
CLERK_SECRET_KEY="sk_test_"

# Optional. The app already sets these in src/components/auth/clerk/provider.tsx.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/auth/continue"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/auth/continue"

# --- Google Cloud (Gmail API + Calendar API, OAuth client) ---
# Add this authorized redirect URI on the OAuth client:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of this app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: Gmail push notifications ---
# Pub/Sub topic, e.g. projects/<gcp-project>/topics/<topic>
# GMAIL_PUBSUB_TOPIC=""
# Public URL that receives Corsair webhooks. Use an ngrok HTTPS URL in local dev.
# Falls back to NEXT_PUBLIC_APP_URL when unset.
# WEBHOOK_BASE_URL=""

# OpenAI is not an environment variable.
# Each user pastes their own key during onboarding; it is stored encrypted per tenant.
